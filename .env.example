# Copie ce fichier en .env.local pour tester en local (npm run dev).
# Sur Vercel, ajoute ces memes variables dans Project Settings -> Environment Variables.

# Depuis Supabase : Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # la cle "service_role", PAS la cle "anon"

# Mot de passe Admin (acces complet : saisie, suppression, import, parametres, restauration)
ADMIN_PASSWORD=change-moi-admin

# Mot de passe Visualisation (lecture + export seulement, pas de saisie/suppression)
VIEWER_PASSWORD=change-moi-visu

# Mot de passe Relanceur (lecture seule partout, SAUF sur la page Relance ou il a acces complet)
RELANCEUR_PASSWORD=change-moi-relanceur

# Chaine secrete aleatoire, sert a signer la session (choisis n'importe quelle longue chaine)
SESSION_SECRET=change-moi-aussi-une-longue-chaine-aleatoire

# Optionnel : protege l'appel manuel de la sauvegarde automatique (Vercel Cron
# l'appelle sans avoir besoin de ceci -- utile seulement si tu veux tester
# manuellement la route /api/cron/backup toi-meme)
CRON_SECRET=change-moi-optionnel
